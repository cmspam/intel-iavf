# Maintainer: cmspam
# pkgver and sha256sums are rewritten by CI to the latest stable upstream
# release on each build. The values committed here are a valid default for
# local builds.
pkgname=iavf-dkms
_pkgname=iavf
pkgver=4.13.35
pkgrel=1
pkgdesc="Intel Ethernet Adaptive Virtual Function (iavf) out-of-tree driver, DKMS"
arch=('any')
url="https://github.com/intel/ethernet-linux-iavf"
license=('GPL-2.0-only')
depends=('dkms')
provides=("iavf=${pkgver}")
source=("${_pkgname}-${pkgver}.tar.gz::https://github.com/intel/ethernet-linux-iavf/releases/download/v${pkgver}/${_pkgname}-${pkgver}.tar.gz")
sha256sums=('d4fc9ff8dbc8e3ac39d51489d8a9d66067869a6821d53dfbd738a29fd2d77a10')

package() {
    local _src="${_pkgname}-${pkgver}"
    install -dm755 "${pkgdir}/usr/src/${_src}"
    cp -a "${srcdir}/${_src}/." "${pkgdir}/usr/src/${_src}/"

    # KSRC is forced to kernel_source_dir because the Intel makefile's own
    # kernel-tree autodetect keys off uname -r, which in a build container
    # (image build, CI) is the build host, not the image kernel DKMS targets.
    cat > "${pkgdir}/usr/src/${_src}/dkms.conf" <<EOF
PACKAGE_NAME="${_pkgname}"
PACKAGE_VERSION="${pkgver}"
AUTOINSTALL="yes"
BUILT_MODULE_NAME[0]="${_pkgname}"
BUILT_MODULE_LOCATION[0]="src/"
DEST_MODULE_LOCATION[0]="/updates/dkms"
MAKE[0]="make -C \${kernel_source_dir} M=\${dkms_tree}/\${PACKAGE_NAME}/\${PACKAGE_VERSION}/build/src KSRC=\${kernel_source_dir} modules"
CLEAN="make -C \${kernel_source_dir} M=\${dkms_tree}/\${PACKAGE_NAME}/\${PACKAGE_VERSION}/build/src KSRC=\${kernel_source_dir} clean"
EOF

    # Select this module over the identically named in-kernel iavf.
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/depmod.d/00-iavf-dkms.conf" <<'EOF'
override iavf * updates/dkms
EOF
}
